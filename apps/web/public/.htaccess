# ─────────────────────────────────────────────────────────────────────────────
# Mehar Importer & Exporter Co. — static SPA on Hostinger shared hosting (Apache)
# Upload the contents of this folder into public_html. This file must sit at the
# web root next to index.html and contact.php.
# ─────────────────────────────────────────────────────────────────────────────

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Force HTTPS (skip if the host already terminates TLS via X-Forwarded-Proto).
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Serve real files and directories as-is (assets, contact.php, images, etc.).
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Serve a matching prerendered page, e.g. /privacy-policy -> privacy-policy.html
	RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.html -f
	RewriteRule ^(.+)$ /$1.html [L]

	# SPA fallback: unknown routes load the empty client shell, which renders
	# the correct route (including the 404 page) without flashing the homepage.
	RewriteRule ^ __spa-fallback.html [L]
</IfModule>

# ── Compression ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml \
		application/javascript application/json image/svg+xml application/x-javascript \
		application/manifest+json text/javascript
</IfModule>
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Caching ──────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
	ExpiresActive On
	# Content-hashed build assets: cache hard for a year.
	<FilesMatch "\.(js|css|woff2|woff|ttf|eot)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(webp|avif|jpg|jpeg|png|gif|svg|ico)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	# HTML should always revalidate so deploys show immediately.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# CSP compatible with the bundled JS/CSS, Google Fonts, WhatsApp links and data: images.
	# 'unsafe-inline' is required for the router's hydration script and framer-motion's
	# inline styles on a static host (no nonce possible without a server).
	Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# Protect the rate-limit scratch files, if created next to the script.
<FilesMatch "^\.mehar_rate">
	Require all denied
</FilesMatch>

ErrorDocument 404 /__spa-fallback.html
